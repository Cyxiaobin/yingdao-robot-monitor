<view class="page-wrap">
  <!-- 顶部 Hero：深色渐变 + 四格概览 -->
  <view class="hero">
    <view class="hero-top">
      <view class="hero-brand"><view class="brand-dot"></view><text>YINGDAO RPA · LIVE MONITOR</text></view>
      <view class="conn-chip {{connected ? 'on' : ''}}">
        <view class="chip-dot"></view><text>{{connected ? '实时连接' : '连接中'}}</text>
      </view>
    </view>
    <view class="hero-title">机器人指挥中心</view>
    <view class="hero-sub">更新于 {{tsShort}}</view>
    <view class="hero-stats">
      <view class="hstat">
        <text class="hstat-num">{{overview.bot_online}}</text>
        <text class="hstat-label">在线机器人</text>
      </view>
      <view class="hstat">
        <text class="hstat-num">{{overview.runs_today}}</text>
        <text class="hstat-label">今日运行</text>
      </view>
      <view class="hstat">
        <text class="hstat-num good">{{overview.success_rate}}<text class="hstat-unit">%</text></text>
        <text class="hstat-label">成功率</text>
      </view>
      <view class="hstat">
        <text class="hstat-num warn">{{alarmCount}}</text>
        <text class="hstat-label">异常待处理</text>
      </view>
    </view>
  </view>

  <view class="content">
    <view wx:if="{{errorMsg}}" class="err-bar" bindtap="onRetryTap">{{errorMsg}} · 点击重试</view>

    <!-- ============ 看板 ============ -->
    <block wx:if="{{activeTab === 'board'}}">
      <view class="seg">
        <view class="seg-item {{segment === 'bots' ? 'on' : ''}}" bindtap="onSegmentTap" data-segment="bots">机器人</view>
        <view class="seg-item {{segment === 'running' ? 'on' : ''}}" bindtap="onSegmentTap" data-segment="running">运行中</view>
        <view class="seg-item {{segment === 'done' ? 'on' : ''}}" bindtap="onSegmentTap" data-segment="done">已完成</view>
      </view>

      <view wx:if="{{segment === 'bots'}}" class="card">
        <view class="card-head">
          <text class="card-title">{{segmentTitle}}</text>
          <view class="head-right">
            <text class="card-meta">{{overview.bot_online}}/{{overview.bot_total}} 在线</text>
            <text class="mini-btn" catchtap="onRefreshTap">刷新</text>
          </view>
        </view>
        <view wx:if="{{loading && !shownBots.length}}" class="empty">加载中...</view>
        <block wx:for="{{shownBots}}" wx:key="uuid">
          <view class="row" bindtap="onBotTap"
            data-uuid="{{item.uuid}}"
            data-name="{{item.name}}"
            data-status="{{item.status}}"
            data-statuslabel="{{item.statusLabel}}"
            data-statuscolor="{{item.statusColor}}"
            data-statusbg="{{item.statusBg}}"
            data-ip="{{item.ip}}"
            data-currentapp="{{item.currentApp}}">
            <view class="avatar" style="background:{{item.statusColor}}">{{item.initials}}</view>
            <view class="row-main">
              <view class="row-title">{{item.currentApp || item.name}}</view>
              <view class="row-sub">{{item.name}} · {{item.ip}}</view>
            </view>
            <view wx:if="{{item.status === 'running'}}" class="live-dot"></view>
            <text class="tag" style="color:{{item.statusColor}};background:{{item.statusBg}}">{{item.statusLabel}}</text>
          </view>
        </block>
        <view wx:if="{{!loading && !shownBots.length}}" class="empty">{{segmentEmpty}}</view>
      </view>
      <view wx:else class="card">
        <view class="card-head">
          <text class="card-title">{{segmentTitle}}</text>
          <text class="card-meta">{{shownRuns.length}} 条</text>
        </view>
        <block wx:for="{{shownRuns}}" wx:key="id">
          <view class="tl-row">
            <view class="tl-rail">
              <view class="tl-dot" style="background:{{item.stateColor}}"></view>
              <view class="tl-line"></view>
            </view>
            <view class="tl-body">
              <view class="tl-top">
                <text class="tl-name">{{item.appName}}</text>
                <text class="tag tag-plain" style="color:{{item.stateColor}}">{{item.stateLabel}}</text>
              </view>
              <view class="tl-meta">{{item.durationText}}</view>
              <view class="ops">
                <text class="op" catchtap="onDrawerTap" data-id="{{item.id}}" data-bot="{{item.botUuid}}" data-mode="detail">查看详情</text>
                <text wx:if="{{item.state === 'running' && allowControl}}" class="op danger" catchtap="onStopTap" data-task="{{item.id}}" data-bot="{{item.botUuid}}">停止</text>
              </view>
            </view>
          </view>
        </block>
        <view wx:if="{{!loading && !shownRuns.length}}" class="empty">{{segmentEmpty}}</view>
      </view>
    </block>
    <block wx:elif="{{activeTab === 'alarm'}}">
      <view class="card">
        <view class="card-head">
          <text class="card-title">未处理异常</text>
          <text class="card-meta">{{alarmCount}} 条</text>
        </view>
        <block wx:for="{{alarms}}" wx:key="id">
          <view class="alarm-card">
            <view class="alarm-top">
              <view class="alarm-icon">!</view>
              <view class="row-main">
                <view class="row-title">{{item.appName}}</view>
                <view class="row-sub">{{item.reason}}</view>
                <view class="row-sub">{{item.timeText}}</view>
              </view>
              <text class="tag tag-plain" style="color:{{item.stateColor}}">{{item.stateLabel}}</text>
            </view>
            <view class="ops">
              <text class="op" catchtap="onDrawerTap" data-id="{{item.id}}" data-bot="{{item.botUuid}}" data-mode="detail">查看详情</text>
              <text class="op" catchtap="onDrawerTap" data-id="{{item.id}}" data-bot="{{item.botUuid}}" data-mode="logs">错误日志</text>
              <text wx:if="{{item.hasScreenshot}}" class="op" catchtap="onScreenshotTap" data-url="{{item.screenshotUrl}}" data-id="{{item.id}}" data-bot="{{item.botUuid}}">失败截图</text>
              <text wx:if="{{allowControl}}" class="op danger" catchtap="onRetryRunTap" data-task="{{item.id}}" data-bot="{{item.botUuid}}">重试流程</text>
              <text class="op" catchtap="onMarkAlarm" data-id="{{item.id}}">标记已处理</text>
              <text class="op muted" catchtap="onIgnoreAlarm" data-id="{{item.id}}">忽略</text>
            </view>
          </view>
        </block>
        <view wx:if="{{!loading && !alarms.length}}" class="empty">没有未处理的异常，运行状况良好</view>
      </view>
      <view class="card quick-card">
        <text class="op" bindtap="onClearHandled">恢复已处理记录（{{handledCount}}）</text>
        <text class="op" bindtap="onGoAppsTap">搜索并运行流程</text>
      </view>
      <view class="note">异常来自影刀最近运行记录；标记状态保存在本机，后端已对同一应用同一原因做 5 分钟推送去重。</view>
    </block>
    <block wx:elif="{{activeTab === 'apps'}}">
      <view class="search-bar">
        <input class="search-input" value="{{keyword}}" bindinput="onKeywordInput"
          bindconfirm="onSearchApps" confirm-type="search"
          placeholder="搜索已发布流程 / 负责人" />
        <text wx:if="{{keyword}}" class="search-clear" catchtap="onClearKeyword">清除</text>
        <view class="search-btn" catchtap="onSearchApps">搜索</view>
      </view>
      <view class="picker-row">
        <text class="picker-label">执行机器人</text>
        <picker mode="selector" range="{{botOptions}}" value="{{accountIndex}}" bindchange="onAccountChange">
          <view class="picker-value">{{botOptions[accountIndex]}}</view>
        </picker>
      </view>
      <view class="card">
        <view class="card-head">
          <text class="card-title">已发布流程</text>
          <view class="head-right">
            <text class="card-meta">{{appTotal}} 个</text>
            <text class="mini-btn" catchtap="onRefreshApps">刷新目录</text>
          </view>
        </view>
        <block wx:for="{{apps}}" wx:key="appId">
          <view class="app-row">
            <view class="app-icon">流</view>
            <view class="row-main">
              <view class="row-title">{{item.appName}}</view>
              <view class="row-sub">{{item.ownerName}} · {{item.publishTime}}</view>
            </view>
            <text class="ver">v{{item.version}}</text>
            <view wx:if="{{allowControl && item.runnable}}" class="run-btn" catchtap="onRunAppTap"
              data-id="{{item.appId}}" data-name="{{item.appName}}">运行</view>
          </view>
        </block>
        <view wx:if="{{!appLoading && !apps.length}}" class="empty">没有匹配的已发布流程</view>
        <view wx:if="{{appHasMore}}" class="more-btn" bindtap="onLoadMoreApps">加载更多</view>
        <view wx:if="{{appLoading}}" class="empty">加载中...</view>
        <view wx:if="{{appMsg}}" class="hint">{{appMsg}}</view>
      </view>
      <view class="note">运行会在影刀生产环境真实启动流程，请先确认业务影响；应用不存在或未发布时后端会直接拒绝。</view>
    </block>
    <block wx:else>
      <view class="section-head"><text class="section-title">后端连接</text></view>
      <view class="card form-card">
        <text class="form-label">后端地址</text>
        <input class="form-input" value="{{baseInput}}" bindinput="onBaseInput"
          placeholder="http://192.168.0.158:8000" />
        <view class="btn-row">
          <view class="btn-mini primary" bindtap="onSaveBase">保存并重连</view>
          <view class="btn-mini" bindtap="onTestBase">测试连接</view>
          <view class="btn-mini" bindtap="onResetBase">恢复默认</view>
        </view>
        <view class="info-line"><text class="info-key">当前生效</text><text class="info-val">{{backendBase}}</text></view>
        <view class="info-line"><text class="info-key">连接状态</text><text class="info-val">{{connState}}</text></view>
        <view class="info-line"><text class="info-key">实时通道</text><text class="info-val">{{connected ? '已连接' : '未连接'}}</text></view>
      </view>

      <view class="section-head"><text class="section-title">影刀开放 API 凭证</text></view>
      <view class="card form-card">
        <view class="info-line"><text class="info-key">当前 Key ID</text><text class="info-val">{{settings.accessKeyIdMasked || '未配置'}}</text></view>
        <view class="info-line"><text class="info-key">运行模式</text><text class="info-val">{{settings.mockMode ? 'MOCK 演示' : '真实影刀数据'}}</text></view>
        <text class="form-label">AccessKey ID</text>
        <input class="form-input" value="{{keyIdInput}}" bindinput="onKeyIdInput" placeholder="影刀控制台创建" />
        <text class="form-label">AccessKey Secret</text>
        <input class="form-input" password value="{{keySecretInput}}" bindinput="onKeySecretInput" placeholder="仅提交时传到后端" />
        <block wx:if="{{settings.adminTokenRequired}}">
          <text class="form-label">管理口令</text>
          <input class="form-input" password value="{{tokenInput}}" bindinput="onTokenInput" placeholder="服务端 ADMIN_TOKEN" />
        </block>
        <view class="btn-row">
          <view class="btn-mini primary" bindtap="onSaveCredentials">保存凭证</view>
          <view class="btn-mini" bindtap="onTestCredentials">验证凭证</view>
        </view>
        <view wx:if="{{credState}}" class="hint">{{credState}}</view>
        <view class="note">这里配的是影刀开放 API 凭证，不是微信 AppID / AppSecret。Secret 只写入后端 .env 并热更新，不存手机、不回显、不进日志。</view>
      </view>

      <view class="section-head"><text class="section-title">登录账号</text></view>
      <view class="card form-card">
        <view class="info-line"><text class="info-key">当前登录</text><text class="info-val">{{currentUser || '未登录'}}</text></view>
        <view class="info-line"><text class="info-key">角色</text><text class="info-val">{{currentRole || '—'}}</text></view>
        <view class="info-line"><text class="info-key">数据范围</text><text class="info-val">{{scopeLabel}}</text></view>
        <view class="info-line"><text class="info-key">登录校验</text><text class="info-val">{{authEnabled ? '已开启' : '已关闭（本地调试）'}}</text></view>
        <text class="form-label">修改自己的密码（改完需重新登录）</text>
        <input class="form-input" password value="{{oldPwdInput}}" bindinput="onOldPwdInput" placeholder="旧密码" />
        <input class="form-input" password value="{{newPwdInput}}" bindinput="onNewPwdInput" placeholder="新密码，至少 6 位" />
        <view class="btn-row">
          <view class="btn-mini primary" bindtap="onChangePassword">修改密码</view>
          <view class="btn-mini" bindtap="onLogout">退出登录</view>
        </view>
        <view wx:if="{{accountMsg}}" class="hint">{{accountMsg}}</view>
      </view>

      <block wx:if="{{isAdmin}}">
        <view class="section-head"><text class="section-title">账号管理 · 仅超级管理员</text></view>
        <view class="card form-card">
          <text class="form-label">新账号（3-32 位字母、数字或 . _ @ -）</text>
          <input class="form-input" value="{{newUserInput}}" bindinput="onNewUserInput" placeholder="例如 zhangsan" />
          <text class="form-label">初始密码（至少 6 位）</text>
          <input class="form-input" password value="{{newUserPwd}}" bindinput="onNewUserPwd" placeholder="初始密码" />
          <view class="btn-row">
            <view class="btn-mini primary" bindtap="onAddUser">创建普通用户</view>
            <view class="btn-mini" bindtap="onRefreshUsers">刷新列表</view>
          </view>
          <view class="note">普通用户与管理员在看板、异常、应用、设置上权限相同；只有本区块是管理员专属。</view>
        </view>
        <view class="card">
          <view class="card-head">
            <text class="card-title">账号列表</text>
            <text class="card-meta">{{userCount}} 个</text>
          </view>
          <block wx:for="{{users}}" wx:key="username">
            <view class="user-row">
              <view class="user-badge">{{item.firstLetter}}</view>
              <view class="row-main">
                <view class="row-title">{{item.username}}</view>
                <view class="row-sub">{{item.roleText}} · 创建于 {{item.createdText}}</view>
              </view>
              <text wx:if="{{item.builtin}}" class="tag tag-plain">内置</text>
              <text wx:else class="op danger" catchtap="onDeleteUser" data-user="{{item.username}}">删除</text>
            </view>
          </block>
          <view wx:if="{{!users.length}}" class="empty">暂无账号</view>
        </view>
      </block>

      <view class="section-head"><text class="section-title">环境信息</text></view>
      <view class="card form-card">
        <view class="info-line"><text class="info-key">数据源</text><text class="info-val">影刀开放 API</text></view>
        <view class="info-line"><text class="info-key">环境</text><text class="info-val">{{envName}}</text></view>
        <view class="info-line"><text class="info-key">运行记录</text><text class="info-val">仅展示当天</text></view>
        <view class="info-line"><text class="info-key">远程控制</text><text class="info-val">{{allowControl ? '已启用' : '已关闭'}}</text></view>
        <view class="info-line"><text class="info-key">轮询间隔</text><text class="info-val">{{settings.pollInterval || 5}} 秒</text></view>
        <view class="info-line"><text class="info-key">本地已处理</text><text class="info-val">{{handledCount}} 条</text></view>
      </view>
      <view class="note">微信服务通知需小程序 AppID + 订阅消息模板 ID，配置后由后端推送。当前版本报警在应用内实时提示，不采集任何用户信息。</view>
    </block>
  </view>

  <!-- 详情抽屉：状态 / 错误备注 / 错误日志 / 现场截图 / 重试 -->
  <view wx:if="{{drawerShow}}" class="drawer-mask" bindtap="onCloseDrawer"></view>
  <view wx:if="{{drawerShow}}" class="drawer">
    <view class="drawer-handle"></view>
    <view class="drawer-head">
      <text class="drawer-title">{{drawerRun.appName}}</text>
      <text class="drawer-close" bindtap="onCloseDrawer">关闭</text>
    </view>
    <scroll-view scroll-y class="drawer-body">
      <view class="drawer-meta">
        <text class="tag tag-plain" style="color:{{drawerRun.stateColor}}">{{drawerRun.stateLabel}}</text>
        <text class="drawer-meta-text">{{drawerRun.durationText}}</text>
      </view>
      <view wx:if="{{drawerRemark}}" class="remark">{{drawerRemark}}</view>
      <view class="drawer-section">错误日志</view>
      <view wx:if="{{drawerLoading}}" class="empty">加载中...</view>
      <block wx:for="{{drawerLogs}}" wx:key="logId">
        <view class="log-row {{item.isError ? 'err' : ''}}">
          <text class="log-time">{{item.time}}</text>
          <text class="log-text">{{item.content}}</text>
        </view>
      </block>
      <view wx:if="{{drawerLogNotice}}" class="hint">{{drawerLogNotice}}</view>
      <view wx:if="{{!drawerLoading && !drawerLogs.length && !drawerLogNotice}}" class="hint">暂无日志记录</view>
      <block wx:if="{{drawerShot}}">
        <view class="drawer-section">现场截图</view>
        <image class="drawer-shot" src="{{drawerShot}}" mode="widthFix" bindtap="onDrawerShotTap"></image>
      </block>
    </scroll-view>
    <view class="drawer-foot">
      <view wx:if="{{drawerCanRetry}}" class="btn-danger" bindtap="onRetryRunTap"
        data-task="{{drawerRun.id}}" data-bot="{{drawerRun.botUuid}}">重试流程</view>
      <view class="btn-plain" bindtap="onCloseDrawer">关闭</view>
    </view>
  </view>

  <!-- 底部 4 Tab -->
  <view class="tabbar">
    <view class="tab-item {{activeTab === 'board' ? 'active' : ''}}" bindtap="onTabTap" data-tab="board">
      <view class="tab-mark"></view><text>看板</text>
    </view>
    <view class="tab-item {{activeTab === 'alarm' ? 'active' : ''}}" bindtap="onTabTap" data-tab="alarm">
      <view class="tab-mark"></view><text>异常</text>
      <text wx:if="{{alarmCount > 0}}" class="tab-badge">{{alarmCount}}</text>
    </view>
    <view class="tab-item {{activeTab === 'apps' ? 'active' : ''}}" bindtap="onTabTap" data-tab="apps">
      <view class="tab-mark"></view><text>应用</text>
    </view>
    <view class="tab-item {{activeTab === 'settings' ? 'active' : ''}}" bindtap="onTabTap" data-tab="settings">
      <view class="tab-mark"></view><text>设置</text>
    </view>
  </view>
</view>
