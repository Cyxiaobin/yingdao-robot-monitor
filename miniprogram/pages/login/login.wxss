/* 登录页：与看板 Hero 同一套深紫渐变，卡片留白对齐黄金比例 */
.lp-page {
  min-height: 100vh;
  background: #f4f5fa;
  padding-bottom: 60rpx;
}
.lp-hero {
  padding: 90rpx 48rpx 110rpx;
  background: linear-gradient(135deg, #26215c 0%, #453aa8 58%, #6c5ce7 100%);
  border-bottom-left-radius: 48rpx;
  border-bottom-right-radius: 48rpx;
  color: #ffffff;
}
.lp-logo {
  width: 88rpx;
  height: 88rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  margin-bottom: 36rpx;
}
.lp-title { font-size: 42rpx; font-weight: 700; letter-spacing: 1rpx; }
.lp-sub { font-size: 24rpx; color: rgba(255, 255, 255, 0.72); margin-top: 14rpx; }

.lp-card {
  margin: -64rpx 36rpx 0;
  padding: 44rpx 36rpx 36rpx;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 16rpx 50rpx rgba(38, 33, 92, 0.10);
}
.lp-label {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #65637c;
  margin: 0 0 12rpx;
}
.lp-input {
  height: 88rpx;
  padding: 0 24rpx;
  margin-bottom: 28rpx;
  border: 2rpx solid #ecebf2;
  border-radius: 18rpx;
  background: #fafafd;
  font-size: 28rpx;
  color: #1c1b2e;
}
.lp-btn {
  height: 92rpx;
  border-radius: 20rpx;
  background: #534ab7;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 26rpx rgba(83, 74, 183, 0.26);
}
.lp-btn.disabled { opacity: 0.65; }
.lp-btn.small { height: 76rpx; font-size: 26rpx; margin-bottom: 18rpx; }
.lp-error {
  font-size: 24rpx;
  color: #d64545;
  background: #fcebeb;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
}
.lp-note {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid #f0eff6;
  font-size: 22rpx;
  line-height: 1.75;
  color: #9b98ab;
}
.lp-checking { text-align: center; font-size: 26rpx; color: #9b98ab; padding: 40rpx 0; }
.lp-base {
  margin: 40rpx auto 0;
  text-align: center;
  font-size: 24rpx;
  color: #534ab7;
}
.lp-base-card { margin-top: 20rpx; }
.lp-current { font-size: 21rpx; color: #9b98ab; word-break: break-all; }
