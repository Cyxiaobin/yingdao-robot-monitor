.detail-wrap {
  min-height: 100vh;
  padding: 24rpx 0 60rpx;
}

.info-card {
  background: #ffffff;
  border-radius: 24rpx;
  margin: 0 24rpx 24rpx;
  padding: 32rpx;
}

.info-head {
  display: flex;
  align-items: center;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.info-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 500;
  color: var(--color-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.info-line {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0 0;
  font-size: 26rpx;
}

.info-key {
  color: var(--color-text-hint);
}

.info-val {
  color: var(--color-text);
}

.err-bar {
  margin: 0 24rpx 16rpx;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  background: #fcebeb;
  color: #a32d2d;
  font-size: 24rpx;
}

.log-row {
  padding: 20rpx 32rpx;
  border-bottom: 1rpx solid var(--color-border);
  font-size: 24rpx;
  line-height: 1.6;
}

.log-time {
  color: var(--color-text-hint);
  margin-right: 16rpx;
}

.log-level {
  color: #1d9e75;
  margin-right: 16rpx;
}

.log-error {
  color: #e24b4a;
}

.log-content {
  color: var(--color-text);
  word-break: break-all;
}

.stop-bar {
  margin: 0 24rpx 24rpx;
  padding: 24rpx 32rpx;
  background: #fcebeb;
  border-radius: 24rpx;
}

.stop-btn {
  text-align: center;
  font-size: 28rpx;
  color: #ffffff;
  background: #e24b4a;
  border-radius: 12rpx;
  padding: 18rpx 0;
}

.stop-note {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #a32d2d;
  margin-top: 14rpx;
}
