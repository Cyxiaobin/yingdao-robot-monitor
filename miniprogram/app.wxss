@import "styles/variables.wxss";

page {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 28rpx;
  color: var(--color-text);
  background-color: var(--color-bg);
  box-sizing: border-box;
}

view, text, image {
  box-sizing: border-box;
}

.page-wrap {
  min-height: 100vh;
  padding-bottom: 140rpx;
}

.card {
  background: var(--color-surface);
  border-radius: 24rpx;
  margin: 0 24rpx 24rpx;
  overflow: hidden;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx 8rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text);
}

.section-more {
  font-size: 24rpx;
  color: var(--color-text-hint);
}

.row {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.row:last-child {
  border-bottom: none;
}

.status-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.row-main {
  flex: 1;
  min-width: 0;
}

.row-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-sub {
  font-size: 22rpx;
  color: var(--color-text-hint);
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tag {
  font-size: 22rpx;
  border-radius: 16rpx;
  padding: 6rpx 18rpx;
  flex-shrink: 0;
}

.empty {
  padding: 80rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-text-hint);
}
