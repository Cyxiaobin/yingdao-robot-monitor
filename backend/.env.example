# 影刀企业控制台 -> api 配置页生成。切勿提交真实值到版本库。
YINGDAO_ACCESS_KEY_ID=
YINGDAO_ACCESS_KEY_SECRET=

# 0 = 调真实影刀接口；1 = 使用本地模拟数据（默认，便于无密钥开发/测试）
YINGDAO_MOCK=1

# 影刀 API 域名；专有云企业请改为专有云地址
YINGDAO_BASE_URL=https://api.yingdao.com

# 后端轮询间隔（秒）
POLL_INTERVAL=5

# 是否启动后台轮询任务（测试时置 0）
ENABLE_POLLER=1

# ---- 登录与账号（2026-11-17）----
# 1=所有接口需登录（默认）；0=免登录，仅限本地开发 / 自动化测试
AUTH_REQUIRED=1
# 首次启动自动创建的内置超级管理员；部署后请立刻修改密码
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=admin123
# 账号库路径，留空则使用 backend/data/users.json（已加入 .gitignore）
AUTH_USERS_FILE=
# 会话有效期（小时）
SESSION_TTL_HOURS=12
# 保存影刀凭证时的额外管理口令；留空表示不启用
ADMIN_TOKEN=
# 是否允许远程启动 / 重试 / 停止流程
ALLOW_REMOTE_CONTROL=1

# ---- 生产安全加固（2026-11-18）----
# 影刀终态回调校验头：设置后 /api/callback 必须带 X-Callback-Token 匹配；生产必配
CALLBACK_TOKEN=
# 1=内置超管首次登录后只允许改密，防止 admin123 长期在用（默认 1；仅限本地调试置 0）
ENFORCE_PASSWORD_CHANGE=1
# 1=启动必须有真实影刀凭证，否则拒绝启动；生产必配，杜绝静默降级成 MOCK 假数据
STRICT_REAL=0

